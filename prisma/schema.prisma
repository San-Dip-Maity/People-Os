// PeopleOS Multi-Tenant HRMS Database Schema
// Prisma 6 with PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Core Tenancy & Membership
// -------------------------------------------------------------

model Tenant {
  id                String             @id @default(uuid())
  slug              String             @unique
  name              String
  isActive          Boolean            @default(true)
  settings          Json?              // Global tenant preferences
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  users             UserMembership[]
  auditLogs         AuditLog[]
  employees         Employee[]
  leaveRequests     LeaveRequest[]
  attendanceRecords AttendanceRecord[]
  workflowItems     WorkflowItem[]
  payrollRuns       PayrollRun[]
  jobRequisitions   JobRequisition[]
  goals             GoalOKR[]
  documents         DocumentRecord[]
  holidays          Holiday[]
  timesheets        Timesheet[]
  notifications     Notification[]

  @@index([slug])
  @@index([isActive])
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  passwordHash   String
  firstName      String
  lastName       String
  isSuperAdmin   Boolean          @default(false)
  isActive       Boolean          @default(true)
  avatarUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  memberships    UserMembership[]
  sessions       Session[]
  auditLogs      AuditLog[]

  @@index([email])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  userAgent    String?
  ipAddress    String?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model UserMembership {
  id         String     @id @default(uuid())
  tenantId   String
  userId     String
  role       String     @default("EMPLOYEE") // SUPER_ADMIN, ORG_ADMIN, HR_ADMIN, HR_MANAGER, DEPT_MANAGER, EMPLOYEE
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

// -------------------------------------------------------------
// Workforce & Employee Directory
// -------------------------------------------------------------

model Employee {
  id             String             @id @default(uuid())
  tenantId       String
  code           String
  name           String
  email          String
  phone          String?
  department     String
  designation    String
  legalEntity    String
  workLocation   String
  employmentType String             @default("Full-Time Permanent")
  status         String             @default("ACTIVE") // ACTIVE, PROBATION, NOTICE, TERMINATED
  joinDate       String
  manager        String?
  avatar         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRequests  LeaveRequest[]
  attendanceRecords AttendanceRecord[]

  @@unique([tenantId, code])
  @@index([tenantId, email])
  @@index([tenantId, department])
  @@index([tenantId, status])
}

// -------------------------------------------------------------
// Time & Leave Management
// -------------------------------------------------------------

model LeaveRequest {
  id             String    @id @default(uuid())
  tenantId       String
  employeeId     String?
  employeeName   String
  department     String
  type           String    // Annual Leave, Sick Leave, Casual Leave, Remote Work
  startDate      String
  endDate        String
  daysCount      Float
  reason         String?
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy     String?
  decisionNotes  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
}

model AttendanceRecord {
  id             String    @id @default(uuid())
  tenantId       String
  employeeId     String?
  employeeName   String
  date           String    // YYYY-MM-DD
  checkIn        String?
  checkOut       String?
  totalDuration  String?
  status         String    @default("PRESENT") // PRESENT, LATE, HALF_DAY, ABSENT, ON_LEAVE
  shift          String    @default("General (09:00 - 18:00)")
  ipAddress      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@index([tenantId, employeeId])
}

// -------------------------------------------------------------
// Unified Workflow Approvals
// -------------------------------------------------------------

model WorkflowItem {
  id             String    @id @default(uuid())
  tenantId       String
  code           String
  title          String
  type           String    // Annual Leave, Attendance Regularization, Air Entitlement Claim
  employee       String
  details        String
  entity         String
  level          String
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// -------------------------------------------------------------
// Audit Logging
// -------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?
  actorId     String?
  action      String   // CREATE, UPDATE, DELETE, APPROVE, REJECT, EXPORT, LOGIN
  resource    String   // Tenant, User, Employee, Leave, Payroll, etc.
  resourceId  String?
  details     Json?    // Diff or contextual payload
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, action])
  @@index([tenantId, resource, resourceId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// Password Reset Verification
// -------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
}

// -------------------------------------------------------------
// Payroll & Compensation Models
// -------------------------------------------------------------

model PayrollRun {
  id                  String               @id @default(uuid())
  tenantId            String
  cycleName           String               // e.g. "November 2026"
  grossAmount         String               // formatted or decimal string
  statutoryDeductions String
  netAmount           String
  status              String               @default("PREVIEW") // PREVIEW, FINALIZED, PAID
  locked              Boolean              @default(false)
  lockedAt            DateTime?
  lockedBy            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records             CompensationRecord[]

  @@index([tenantId, cycleName])
  @@index([tenantId, status])
}

model CompensationRecord {
  id           String      @id @default(uuid())
  tenantId     String
  payrollRunId String
  employeeName String
  legalEntity  String
  currency     String      @default("AED")
  baseSalary   String
  allowances   String
  deductions   String
  netPayable   String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  payrollRun   PayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([payrollRunId])
  @@index([tenantId])
}

// -------------------------------------------------------------
// Recruitment & ATS Models
// -------------------------------------------------------------

model JobRequisition {
  id              String   @id @default(uuid())
  tenantId        String
  code            String
  title           String
  department      String
  legalEntity     String
  workLocation    String
  applicantsCount Int      @default(0)
  status          String   @default("PUBLISHED") // DRAFT, PUBLISHED, INTERVIEWING, CLOSED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, department])
}

// -------------------------------------------------------------
// Performance Management & OKRs
// -------------------------------------------------------------

model GoalOKR {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  category    String   // COMPANY, DEPARTMENT, INDIVIDUAL
  owner       String
  department  String
  progress    Int      @default(0) // 0 - 100
  targetDate  String
  status      String   @default("ON_TRACK") // ON_TRACK, AT_RISK, BEHIND, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, department])
}

// -------------------------------------------------------------
// Document Management & Policies
// -------------------------------------------------------------

model DocumentRecord {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  category    String   // Policies & Handbooks, Contracts & Letters, IDs & Compliance
  fileSize    String
  scope       String   @default("All Employees")
  expiresAt   String?  // YYYY-MM-DD or "Permanent"
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
}

// -------------------------------------------------------------
// Holiday Calendars
// -------------------------------------------------------------

model Holiday {
  id           String   @id @default(uuid())
  tenantId     String
  calendarCode String   // UAE, IND, USA
  name         String
  date         String   // YYYY-MM-DD or range
  type         String   // Statutory Public, National Holiday, Religious Public
  daysCount    Float    @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, calendarCode])
}

// -------------------------------------------------------------
// Timesheets & Project Hours
// -------------------------------------------------------------

model Timesheet {
  id           String   @id @default(uuid())
  tenantId     String
  employeeName String
  weekNumber   Int
  weekRange    String   // "Nov 02 — Nov 06, 2026"
  totalHours   Float    @default(40.0)
  status       String   @default("SUBMITTED") // DRAFT, SUBMITTED, APPROVED, REJECTED
  reviewer     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, employeeName])
}

// -------------------------------------------------------------
// In-App Notifications
// -------------------------------------------------------------

model Notification {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?
  title       String
  description String
  category    String   @default("SYSTEM") // APPROVALS, SYSTEM, PAYROLL, COMPLIANCE
  isRead      Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isRead])
  @@index([tenantId, category])
}
